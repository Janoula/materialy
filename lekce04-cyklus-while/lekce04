soucet = 0
while True:
    odpoved = input("Zadej cislo (nebo *konec*): ")
    if odpoved == "konec":
        break
    cislo = int(odpoved)
    if cislo < 0:
        print("Zaporna cisla ignoruju.")
        continue
    soucet = soucet + cislo
    print("Zatim mame", soucet)
print("Soucet: ", soucet)
    
